{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User's earning profile and stats",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "balance": { "type": "number" },
        "withdrawn": { "type": "number" },
        "adsWatched": { "type": "integer" },
        "referrals": { "type": "integer" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "lastTaskReset": { "type": "string", "format": "date-time" },
        "dailyStats": {
          "type": "object",
          "description": "Map of date YYYY-MM-DD to earning amount"
        }
      },
      "required": ["uid", "balance"]
    },
    "Task": {
      "title": "Earning Task",
      "description": "A task for users to complete",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "reward": { "type": "number" },
        "url": { "type": "string" },
        "duration": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "reward", "url"]
    },
    "Withdrawal": {
      "title": "Withdrawal Record",
      "description": "A record of a withdrawal request",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "accountDetails": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "success", "failed"] },
        "trxId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "method", "status"]
    },
    "MonetizationTask": {
      "title": "Monetization Task",
      "description": "Ad network task or direct link",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "reward": { "type": "number" },
        "type": { "type": "string", "enum": ["link", "code"] },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "reward", "type", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "Withdrawal",
      "description": "Stores withdrawal requests"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Task management (including normal tasks and monetization bounties)"
    },
    "/settings/global": {
      "schema": "object",
      "description": "Global app settings and support links"
    }
  }
}
